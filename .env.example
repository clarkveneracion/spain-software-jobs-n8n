# Optional Docker configuration; workflow placeholders are configured in n8n.
GENERIC_TIMEZONE=Europe/Madrid
TZ=Europe/Madrid
# Pin a tested n8n image tag before starting a new instance.
N8N_IMAGE_TAG=REPLACE_WITH_TESTED_VERSION
# Generate locally; keep stable and never commit the real value.
N8N_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET
